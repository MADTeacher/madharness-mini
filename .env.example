# Скопируйте этот файл в .env и задайте URL роутера, model slug и токен.
# Эти значения имеют приоритет над .madharness-mini/config.json.

MADHARNESS_MINI_BASE_URL=https://openrouter.ai/api/v1
MADHARNESS_MINI_MODEL=deepseek/deepseek-v4-flash
MADHARNESS_MINI_API_KEY=your-token-here
MADHARNESS_MINI_SUPPORTS_IMAGE_INPUT=false
MADHARNESS_MINI_MAX_IMAGE_BYTES=5000000
MADHARNESS_MINI_IMAGE_DETAIL=auto

# Shell-политика: allow_shell полностью включает/выключает run_shell и
# run_shell_background; allow_shell_interpreter выбирает режим исполнения.
# true (по умолчанию) — команда идёт через /bin/sh -c, поэтому && ; | и
# 2>&1, >/dev/null работают; false — прежний режим без интерпретатора,
# когда control-операторы запрещены. Чёрный список разрушительных команд
# (rm -rf, sudo, curl, ...) и запрет редиректа в файлы действуют в обоих режимах.
MADHARNESS_MINI_ALLOW_SHELL=true
MADHARNESS_MINI_ALLOW_SHELL_INTERPRETER=true
# Сколько фоновых процессов может одновременно висеть через run_shell_background.
MADHARNESS_MINI_MAX_BACKGROUND_PROCESSES=4
